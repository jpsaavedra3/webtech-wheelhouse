<% content_for :title, "Staff" %>

<h1 class="mb-4">Staff</h1>
<%= link_to "New member", new_staff_member_path, class: "btn btn-primary mb-3" %>
<% if @staff_members.empty? %>
  <p class="text-muted">Nobody works here yet.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Role</th>
      </tr>
      </thead>
      <tbody>
      <% @staff_members.each do |staff_member| %>
        <tr>
          <td><%= link_to staff_member.name, staff_member %></td>
          <td><%= staff_member.role.humanize %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
<% end %>
