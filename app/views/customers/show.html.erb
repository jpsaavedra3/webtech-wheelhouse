<% content_for :title, @customer.name %>

<h1 class="mb-1"><%= @customer.name %></h1>
<p class="text-muted mb-4"><%= @customer.phone %></p>

<h2 class="h5 mb-3"><%= pluralize(@bikes.size, "bike") %></h2>
<%= link_to "Add a bike", new_bike_path(customer_id: @customer.id), class: "btn btn-sm btn-outline-primary mb-3" %>

<% if @bikes.empty? %>
  <p class="text-muted">This customer has no bikes registered.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
      <tr>
        <th scope="col">Bike</th>
        <th scope="col">Serial number</th>
        <th scope="col">Colour</th>
        <th scope="col">Owner</th>
      </tr>
      </thead>
      <tbody>
      <%= render @bikes %>
      </tbody>
    </table>
  </div>
<% end %>
<div class="d-flex flex-wrap gap-2 mt-4">
  <%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-outline-primary" %>
  <%= button_to "Delete", @customer, method: :delete,
                class: "btn btn-outline-danger",
                form: { data: { turbo_confirm: "Delete #{@customer.name}? This cannot be undone." } } %>
  <%= link_to "All customers", customers_path, class: "btn btn-outline-secondary" %>
</div>