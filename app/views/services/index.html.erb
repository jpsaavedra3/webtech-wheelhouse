<% content_for :title, "Services" %>

<h1 class="mb-4">What we charge</h1>

<% if @services.empty? %>
  <p class="text-muted">There are no services on the list yet.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
      <tr>
        <th scope="col">Job</th>
        <th scope="col">What it covers</th>
        <th scope="col" class="text-end">Price</th>
      </tr>
      </thead>
      <tbody>
      <%= render @services %>
      </tbody>
    </table>
  </div>
<% end %>