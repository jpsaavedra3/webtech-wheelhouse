<% content_for :title, "Forgot your password?" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <h1 class="mb-4">Forgot your password?</h1>

    <%= form_with url: passwords_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                             value: params[:email_address], class: "form-control" %>
      </div>

      <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
    <% end %>

    <%= link_to "Back to sign in", new_session_path, class: "btn btn-link mt-3 ps-0" %>
  </div>
</div>
