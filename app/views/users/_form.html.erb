<%= form_with model: user do |f| %>
  <%= render "shared/error_summary", object: user %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: field_class(user, :name) %>
    <%= field_errors user, :name %>
  </div>

  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: field_class(user, :role) %>
    <%= field_errors user, :role %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>