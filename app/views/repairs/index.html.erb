<% content_for :title, "Repairs" %>

<h1 class="mb-2">Repairs</h1>
<p class="text-muted mb-4">The soonest promise first. A red row is past the day we promised.</p>

<% if @repairs.empty? %>
  <p class="text-muted">There is nothing in the workshop.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
      <tr>
        <th scope="col">Repair</th>
        <th scope="col">Bike</th>
        <th scope="col">Owner</th>
        <th scope="col">State</th>
        <th scope="col">Promised</th>
      </tr>
      </thead>
      <tbody>
      <%= render @repairs %>
      </tbody>
    </table>
  </div>
<% end %>