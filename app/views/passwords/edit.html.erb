<% content_for :title, "Choose a new password" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <h1 class="mb-4">Choose a new password</h1>

    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <div class="mb-3">
        <%= form.label :password, "New password", class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password",
                                maxlength: 72, class: "form-control" %>
        <div class="form-text">At least 10 characters.</div>
      </div>

      <div class="mb-3">
        <%= form.label :password_confirmation, "Repeat the new password", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                                maxlength: 72, class: "form-control" %>
      </div>

      <%= form.submit "Save", class: "btn btn-primary" %>
    <% end %>

    <%= link_to "Back to sign in", new_session_path, class: "btn btn-link mt-3 ps-0" %>
  </div>
</div>
