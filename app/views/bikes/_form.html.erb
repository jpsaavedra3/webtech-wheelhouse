<%= form_with model: bike do |f| %>
  <%= render "shared/error_summary", object: bike %>

  <div class="mb-3">
    <%= f.label :customer_id, "Owner", class: "form-label" %>
    <%= f.collection_select :customer_id, @customers, :id, :name,
                            { include_blank: "Choose an owner" },
                            { class: field_class(bike, :customer, "form-select") } %>
    <%= field_errors bike, :customer %>
  </div>

  <div class="mb-3">
    <%= f.label :bike_model_id, "Make and model", class: "form-label" %>
    <%= f.collection_select :bike_model_id, @bike_models, :id, :name,
                            { include_blank: "Choose a model" },
                            { class: field_class(bike, :bike_model, "form-select") } %>
    <%= field_errors bike, :bike_model %>
  </div>

  <div class="mb-3">
    <%= f.label :serial_number, class: "form-label" %>
    <%= f.text_field :serial_number, class: field_class(bike, :serial_number) %>
    <div class="form-text">Leave it blank if the serial number is not legible.</div>
    <%= field_errors bike, :serial_number %>
  </div>

  <div class="mb-3">
    <%= f.label :colour, class: "form-label" %>
    <%= f.text_field :colour, class: field_class(bike, :colour) %>
    <%= field_errors bike, :colour %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>