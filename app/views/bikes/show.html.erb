<% content_for :title, "#{@bike.bike_model.brand} #{@bike.bike_model.name}" %>

<h1 class="mb-1"><%= @bike.bike_model.brand %> <%= @bike.bike_model.name %></h1>
<p class="text-muted mb-4">
  <%= @bike.colour %> ·
  Serial <%= @bike.serial_number || "not legible" %> ·
  Owned by <%= link_to @bike.customer.name, @bike.customer %>
</p>

<h2 class="h5 mb-3"><%= pluralize(@repairs.size, "repair") %></h2>

<% if @repairs.empty? %>
  <p class="text-muted">This bike has never been in for a repair.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
      <tr>
        <th scope="col">Repair</th>
        <th scope="col">Bike</th>
        <th scope="col">Owner</th>
        <th scope="col">State</th>
        <th scope="col">Promised</th>
      </tr>
      </thead>
      <tbody>
      <%= render @repairs %>
      </tbody>
    </table>
  </div>
<% end %>

<%= link_to "All bikes", bikes_path, class: "btn btn-outline-secondary mt-3" %>