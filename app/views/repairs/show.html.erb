<% content_for :title, "Repair ##{@repair.id}" %>

<h1 class="mb-1">Repair #<%= @repair.id %></h1>
<p class="text-muted mb-4">
  <%= link_to "#{@repair.bike.bike_model.brand} #{@repair.bike.bike_model.name}", @repair.bike %> ·
  <%= link_to @repair.bike.customer.name, @repair.bike.customer %>
</p>

<div class="row g-4 mb-4">
  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-body">
        <h2 class="card-title h6">This repair</h2>
        <p class="mb-1">
          State:
          <span class="badge text-bg-secondary"><%= @repair.state.humanize %></span>
          <% if @repair.overdue? %>
            <span class="badge text-bg-danger">Overdue</span>
          <% end %>
        </p>
        <p class="mb-1">Received: <%= l(@repair.received_at, format: :long) %></p>
        <p class="mb-1">Promised: <%= l(@repair.promised_on, format: :long) %></p>
        <p class="mb-1">
          Collected:
          <%= @repair.collected_at ? l(@repair.collected_at, format: :long) : "not yet" %>
        </p>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card">
      <div class="card-body">
        <h2 class="card-title h6">The quote</h2>
        <p class="mb-1">Taken in by <%= link_to @repair.received_by.name, @repair.received_by %></p>
        <% if @repair.quote_answered_at %>
          <p class="mb-1">
            Answered <%= l(@repair.quote_answered_at, format: :long) %><% if @repair.quote_answered_by %>,
              recorded by <%= link_to @repair.quote_answered_by.name, @repair.quote_answered_by %><% end %>
          </p>
        <% else %>
          <p class="mb-1 text-muted">No answer recorded yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<h2 class="h5 mb-3"><%= pluralize(@lines.size, "service") %> charged</h2>

<% if @lines.empty? %>
  <p class="text-muted">Nothing has been quoted on this repair yet.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
      <tr>
        <th scope="col">Job</th>
        <th scope="col">Mechanic</th>
        <th scope="col">Finished</th>
        <th scope="col" class="text-end">Charged</th>
      </tr>
      </thead>
      <tbody>
      <%= render @lines %>
      </tbody>
      <tfoot>
      <tr>
        <th scope="row" colspan="3">Total</th>
        <th class="text-end"><%= money(@repair.total) %></th>
      </tr>
      </tfoot>
    </table>
  </div>
<% end %>

<h2 class="h5 mt-4">Diagnosis</h2>

<% if @repair.diagnosis.body.present? %>
  <%= @repair.diagnosis %>
<% else %>
  <p class="text-body-secondary">No diagnosis written yet.</p>
<% end %>

<h2 class="h5 mt-4">Intake photos</h2>

<% if @repair.intake_photos.attached? %>
  <div class="row g-3">
    <% @repair.intake_photos.each do |photo| %>
      <div class="col-6 col-md-4">
        <%= link_to url_for(photo), target: "_blank", rel: "noopener" do %>
          <%= image_tag photo.variant(:medium),
                alt: photo_alt(@repair),
                class: "img-fluid rounded" %>
        <% end %>
        <%= button_to "Remove", photo_repair_path(@repair, photo.id), method: :delete,
              class: "btn btn-sm btn-outline-danger mt-2",
              form: { data: { turbo_confirm: "Remove this photo? This cannot be undone." } } %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-body-secondary">No intake photos for this repair.</p>
<% end %>

<div class="d-flex flex-wrap gap-2 mt-4">
  <%= link_to "Edit", edit_repair_path(@repair), class: "btn btn-outline-primary" %>
  <%= button_to "Delete", @repair, method: :delete,
                class: "btn btn-outline-danger",
                form: { data: { turbo_confirm: "Delete repair ##{@repair.id}? This cannot be undone." } } %>
  <%= link_to "All repairs", repairs_path, class: "btn btn-outline-secondary" %>
</div>